# AI Master Tools — environment
#
# Copy to .env.local for development, and set the same names in Vercel for
# production. Never commit a filled-in copy.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE ADDING A KEY
# ---------------------------------------------------------------------------
# vite.config.ts contains:
#
#   define: {
#     'process.env.API_KEY': JSON.stringify(env.GEMINI_API_KEY),
#     'process.env.GEMINI_API_KEY': JSON.stringify(env.GEMINI_API_KEY)
#   }
#
# `define` is a compile-time text replacement into the CLIENT bundle. The moment
# GEMINI_API_KEY has a value, that value is written into a public JavaScript file
# and served to every visitor. It is empty today, so nothing is leaking — but the
# trap is armed.
#
# Any key that must stay secret belongs in an api/ serverless function, read from
# process.env at request time, and must NOT be given a VITE_ prefix. Only values
# that are safe to publish should ever reach the browser.
# ---------------------------------------------------------------------------

# Public. Used for canonical URLs and Open Graph.
VITE_APP_URL=https://aimastertools.space

# --- Amazon Associates -----------------------------------------------------
# The store id. Public by nature — it appears in every affiliate link — so the
# VITE_ prefix is correct here.
VITE_AMAZON_ASSOCIATE_ID=aimastertools-21

# Product Advertising API. SECRET. Server-side only, no VITE_ prefix, and only
# meaningful once the Associates account is approved for PA-API access.
# Leave blank until then: AmazonPAAPIProvider reports itself unconfigured and
# the site falls back to hand-entered products rather than inventing any.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

# --- AI --------------------------------------------------------------------
# SECRET. See the warning above — this name is currently compiled into the
# client bundle by vite.config.ts. Fix that define before setting this, or the
# key ships to every visitor.
GEMINI_API_KEY=

# --- Analytics -------------------------------------------------------------
# Already hard-coded in index.html (GTM-WZV4CNBG / G-VV4GFEC1ZS). Listed here
# so the values live in one documented place if they are ever moved to config.
VITE_GTM_ID=GTM-WZV4CNBG
VITE_GA4_ID=G-VV4GFEC1ZS

# --- Development -----------------------------------------------------------
# Shows products marked source: 'demo'. Must stay false in production so demo
# rows can never be mistaken for live Amazon listings.
VITE_DEMO_DATA=false
